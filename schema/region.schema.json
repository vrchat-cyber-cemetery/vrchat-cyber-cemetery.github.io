{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Data class: runtime export. Generated regions/NN.json; text summary only, no pixels. Advertises the expected revision of each of the 8 group packs.",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "region": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63
    },
    "layout_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "entries": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CC-\\d{6}$"
          },
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "required": [
          "id",
          "slot",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "groups": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "pack": {
            "type": "integer",
            "minimum": 0,
            "maximum": 511,
            "$comment": "Global pack index region*8+group served by the shard sites."
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "required": [
          "group",
          "pack",
          "revision",
          "url"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "region",
    "layout_version",
    "revision",
    "entries",
    "groups"
  ],
  "additionalProperties": false
}
